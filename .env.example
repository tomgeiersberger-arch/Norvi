# =============================================================================
# NORVI AI — public self-hosting example
# =============================================================================
# Copy to .env only for a manual source installation.
# The graphical/local installers generate these values automatically.
#
# Never commit the real .env file.
# =============================================================================

# --- Public/local mode --------------------------------------------------------
LOCAL_ONLY_MODE=true
NORVI_PUBLIC_EDITION=true
VITE_ENABLE_TELEMETRY=false
EXPO_PUBLIC_ENABLE_TELEMETRY=false

# Browser address for a local install.
WEBSITE_URL=http://localhost:4200
TRUSTED_ORIGINS=http://127.0.0.1:4200

# --- Local data ---------------------------------------------------------------
DATABASE_URL=file:./data/norvi.db
DATABASE_AUTH_TOKEN=
UPLOAD_DIR=data/uploads

# --- Authentication -----------------------------------------------------------
# Local public installs do not require a login by default. If you intentionally
# expose NORVI to other machines/the internet, set REQUIRE_AUTH=true first.
# Generate a strong random BETTER_AUTH_SECRET for manual installs.
# Example: openssl rand -base64 32
BETTER_AUTH_SECRET=
ADMIN_EMAIL=
REQUIRE_AUTH=false
ALLOW_SIGNUP=false

# --- Local AI via Ollama ------------------------------------------------------
AI_PROVIDER=openai-compatible
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=

# Manual source-install defaults. The installer replaces these with local NORVI
# aliases for the selected hardware profile.
AI_MODEL=qwen3:4b
AI_MODELS=qwen3:4b
AI_ULTRA_SERIOUS_MODEL=
AI_FAST_MODEL=qwen3:4b
AI_POWER_MODEL=qwen3:4b
AI_DEEP_MODEL=qwen3:4b

AI_LOCAL_WARMUP=true
AI_LOCAL_WARM_VISION=false
AI_LOCAL_KEEP_ALIVE=30m

AI_ULTRA_SERIOUS_MAX_TOKENS=160
AI_FAST_MAX_TOKENS=256
AI_BALANCED_MAX_TOKENS=512
AI_POWER_MAX_TOKENS=768
AI_DEEP_MAX_TOKENS=1024
AI_VISION_MAX_TOKENS=192

# Vision models. These are official Ollama model tags.
AI_VISION_FAST_MODEL=qwen3-vl:2b
AI_VISION_MODEL=qwen3-vl:4b

# Hosted gateway settings stay empty in local-only mode.
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# --- Local speech-to-text -----------------------------------------------------
STT_LOCAL_ENABLED=true
STT_LOCAL_PORT=8000
STT_LOCAL_MODEL=base
WHISPER_API_HOME=data/whisper-api
STT_BASE_URL=http://127.0.0.1:8000/v1
STT_API_KEY=
STT_MODEL=whisper-1
# Max. Dauer pro Transkription in Millisekunden.
STT_TIMEOUT_MS=30000
