# =============================================================================
# NORVI AI — Beispielkonfiguration fuer Self-Hosting
# =============================================================================
# Kopieren und ausfuellen:
#   cp .env.example .env
#
# Diese Datei enthaelt bewusst KEINE echten Secrets und darf im Git liegen.
# Die echte `.env` ist in .gitignore und wird NIE committet.
#
# Nach jeder Aenderung an der .env den Prozess wirklich neu starten
# (Reload reicht nicht):  sudo systemctl restart norvi
# =============================================================================

# --- Betrieb -----------------------------------------------------------------
# NODE_ENV nicht in diese Datei setzen: Startskript/systemd setzen production,
# waehrend Vite die Build-Umgebung selbst verwaltet.
# Adresse, unter der NORVI im Browser erreichbar ist (ohne Slash am Ende).
# Beispiele: http://100.114.15.10:4200  oder  https://norvi.example.com
WEBSITE_URL=http://localhost:4200
# Zusaetzliche erlaubte Browser-Urspruenge, mit Komma getrennt. Leer lassen,
# wenn nur WEBSITE_URL verwendet wird. Niemals "*" setzen.
TRUSTED_ORIGINS=

# --- Datenbank ---------------------------------------------------------------
# Self-Hosting: lokale SQLite-Datei, kein Cloud-Dienst, kein Token.
# Der Pfad ist relativ zum Projektverzeichnis.
DATABASE_URL=file:./data/norvi.db
DATABASE_AUTH_TOKEN=
# Alternative (gehostetes libsql/Turso) — dann Token zwingend setzen:
#   DATABASE_URL=libsql://<datenbank>.turso.io
#   DATABASE_AUTH_TOKEN=<token>

# --- Anmeldung ---------------------------------------------------------------
# Zufalls-Secret fuer die Session-Signatur. Eigenen Wert erzeugen mit:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional: E-Mail-Adresse, die beim Registrieren Admin-Rechte erhaelt.
# Ohne Angabe wird das allererste angelegte Konto automatisch Admin.
ADMIN_EMAIL=
# Anmeldezwang. Fuer Self-Hosting ist true der sichere Standard: ohne Anmeldung
# kein Chat, kein Upload und keine Spracheingabe. Nur fuer ein rein lokales,
# vertrauenswuerdiges LAN bewusst auf false setzen.
REQUIRE_AUTH=true
# Nach dem ersten Owner-Account sind weitere Registrierungen standardmaessig
# geschlossen. Nur kurzzeitig auf true setzen, wenn ein neuer Nutzer angelegt
# werden soll; danach wieder false setzen und NORVI neu starten.
ALLOW_SIGNUP=false

# --- NORVI KI: lokaler Ollama-Server ----------------------------------------
# Lokaler, OpenAI-kompatibler Endpoint. Keine Cloud, kein externer API-Key.
AI_PROVIDER=openai-compatible
# Ollamas OpenAI-kompatible API — das "/v1" am Ende ist Pflicht.
#   gleicher Rechner wie NORVI : http://localhost:11434/v1
#   ueber Tailscale            : http://100.114.15.10:11434/v1
AI_BASE_URL=http://127.0.0.1:11434/v1
# Modellname exakt wie in `ollama list`.
AI_MODEL=norvi-direct:latest
# Interne Liste erlaubter Modelle (mehrere mit Komma trennen; nicht direkt in der UI gezeigt).
AI_MODELS=norvi-direct:latest
# Performance-Profile fuer die fuenf sichtbaren NORVI-Versionen.
# ULTRA SERIOUS, FAST + STANDARD nutzen das schnelle 2B-Direct-Modell ohne verstecktes Thinking.
# POWER nutzt 4B direkt, DEEP nutzt 4B mit zusaetzlicher Denkzeit:
#   ./deploy/install-direct-model.sh
#   ./deploy/install-power-model.sh
#   ./deploy/install-deep-model.sh
AI_ULTRA_SERIOUS_MODEL=norvi-direct:latest
AI_FAST_MODEL=norvi-direct:latest
AI_POWER_MODEL=norvi-power:latest
AI_DEEP_MODEL=norvi-deep:latest
# Hauptmodell beim Start im Hintergrund laden und fuer schnelle Folgeanfragen warm halten.
AI_LOCAL_WARMUP=true
# Auf dem dedizierten 16-GB-Homeserver true: Text + Vision bleiben warm und sparen Cold-Starts.
AI_LOCAL_WARM_VISION=true
AI_LOCAL_KEEP_ALIVE=24h
AI_ULTRA_SERIOUS_MAX_TOKENS=160
AI_FAST_MAX_TOKENS=256
AI_BALANCED_MAX_TOKENS=512
AI_POWER_MAX_TOKENS=768
AI_DEEP_MAX_TOKENS=1024
AI_VISION_MAX_TOKENS=128
# Ollama braucht keinen Schluessel — leer lassen.
AI_API_KEY=

# Hybrid-Vision fuer CPU-only Self-Hosting:
# FAST verarbeitet normale Fotos/Szenen, MODEL bleibt fuer OCR, Zahlen, Zaehlen,
# feine Details sowie Power/Deep zustaendig. Ist FAST leer, nutzt NORVI immer MODEL.
#   ollama pull qwen3.5:0.8b
#   ollama pull qwen3-vl:2b-instruct
AI_VISION_FAST_MODEL=qwen3.5:0.8b
AI_VISION_MODEL=qwen3-vl:2b-instruct

# Nur fuer den gehosteten Runable-Gateway-Betrieb statt Ollama.
# Im Self-Hosting leer lassen bzw. auskommentiert lassen.
# AI_GATEWAY_BASE_URL=
# AI_GATEWAY_API_KEY=

# --- Spracheingabe (Speech-to-Text), optional --------------------------------
# NORVI kann einen lokalen Whisper-Dienst als Sidecar selbst starten.
# Audio bleibt dabei auf dem Server; der Dienst lauscht nur auf 127.0.0.1.
STT_LOCAL_ENABLED=false
STT_LOCAL_PORT=8000
STT_LOCAL_MODEL=tiny
WHISPER_API_HOME=data/whisper-api
# Bei lokalem Sidecar:
# STT_BASE_URL=http://127.0.0.1:8000/v1
# STT_API_KEY=<zufaelliger-lokaler-schluessel>
# STT_MODEL=whisper-1
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# --- Datei-Uploads -----------------------------------------------------------
# Ablage fuer hochgeladene Bilder, relativ zum Projektverzeichnis.
UPLOAD_DIR=data/uploads

# --- Von der Runable-Plattform verwaltet (im Self-Hosting nicht noetig) ------
# APPLICATION_ID=
# VITE_APPLICATION_ID=
# AUTUMN_SECRET_KEY=
