; systemd-Unit fuer den dauerhaften Betrieb von NORVI AI auf Ubuntu.
;
; Installation:
;   sudo cp deploy/norvi.service /etc/systemd/system/norvi.service
;   sudo nano /etc/systemd/system/norvi.service     # User + WorkingDirectory pruefen
;   sudo systemctl daemon-reload
;   sudo systemctl enable --now norvi
;
; Status und Logs:
;   systemctl status norvi
;   journalctl -u norvi -f
;
; Nach jeder Aenderung an der .env:
;   sudo systemctl restart norvi

[Unit]
Description=NORVI AI (Web + API)
Documentation=https://github.com/tomgeiersberger-arch/Norvi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

; --- NORVI Homeserver --------------------------------------------------------
User=norviadmin
Group=norviadmin
WorkingDirectory=/home/norviadmin/norvi

; Der Port ist im Projekt fest hinterlegt (__ports.cjs -> 4200).
Environment=NODE_ENV=production
Environment=PORT=4200

; Alle uebrigen Variablen kommen aus der .env im Projektverzeichnis.
EnvironmentFile=/home/norviadmin/norvi/.env

; Vollstaendiger Pfad zu bun (pruefen mit: which bun).
ExecStart=/home/norviadmin/.bun/bin/bun packages/web/src/__server.ts

Restart=always
RestartSec=3
TimeoutStopSec=20
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=norvi

; --- Haertung ---------------------------------------------------------------
; Diese beiden Optionen funktionieren auch auf Hosts, auf denen systemd
; Mount-Namespaces (ProtectHome/ProtectSystem) nicht verfuegbar sind.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
