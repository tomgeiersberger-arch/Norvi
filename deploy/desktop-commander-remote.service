# Optional user service: keep Desktop Commander Remote connected after SSH closes.
# Run the interactive authorization once before enabling this unit. No token is
# stored in this file; Desktop Commander reuses its authorization from the
# user's home directory.

[Unit]
Description=Desktop Commander Remote for NORVI
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/share/desktop-commander/node_modules/.bin/desktop-commander remote
Restart=always
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=norvi-remote

[Install]
WantedBy=default.target
